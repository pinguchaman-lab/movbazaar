# TMDB API Configuration (Server-side private key — never exposed to client browsers)
TMDB_API_KEY=your_tmdb_api_key_here
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# VIP Secret Key for cryptographic HMAC-SHA256 session token signing
VIP_SECRET=generate_a_random_32_character_secret_here

# VIP Authorized Accounts (Email:Password comma-separated list)
# Issue these credentials privately to authorized users for 100% Ad-Free VIP streaming
VIP_USERS=user1@domain.com:SecurePass123,user2@domain.com:AnotherPass456

# Canonical deployment domain (used for SEO sitemap & robots)
NEXT_PUBLIC_SITE_URL=https://movbazaar.vercel.app

# Optional OMSS backend endpoint (defaults to multi-server CDN embeds)
NEXT_PUBLIC_OMSS_API_URL=http://localhost:3000

# ==========================================
# Advertising Networks Configuration (Non-AdSense)
# Register at Monetag, Adsterra, or PopAds to monetize your traffic
# When users log in with VIP credentials, all ads are completely disabled.
# ==========================================

# 1. Monetag MultiTag ID (Recommended #1 for streaming — high CPM in India & global)
# Register at: https://monetag.com
# Paste your MultiTag script filename or tag ID (e.g. tag.min.js or your zone script id)
NEXT_PUBLIC_MONETAG_TAG_ID=

# 2. Adsterra Banner Key & Social Bar
# Register at: https://adsterra.com
# Create a 728x90 banner or Social Bar and paste the placement key:
NEXT_PUBLIC_ADSTERRA_BANNER_KEY=
NEXT_PUBLIC_ADSTERRA_KEY=

# 3. PopAds Site ID (Popunder advertising)
# Register at: https://www.popads.net
# Enter your numerical site ID:
NEXT_PUBLIC_POPADS_ID=
